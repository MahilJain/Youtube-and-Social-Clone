
# Server
PORT=8000
CORS_ORIGIN=http://localhost:5173

# MongoDB
MONGODB_URL=mongodb://127.0.0.1:27017

# Authentication
ACCESS_TOKEN_SECRET=replace-with-a-long-random-secret
